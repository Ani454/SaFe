# Copy to .env. The local UI server loads these values; do not commit .env.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT_SECONDS=30

# Integrated website. Production requires a durable disk and stable secret.
SAFE_SECRET_KEY=
SAFE_STORAGE=instance
SAFE_DB=instance/safe.db
SAFE_ENV=development
SAFE_SEARCH_BACKEND=elasticsearch
ES_URL=
ES_API_KEY=
# To explore locally without Elasticsearch, explicitly set SAFE_SEARCH_BACKEND=sqlite.
# This displays a local-backend banner and still requires Mistral for live reporting.
